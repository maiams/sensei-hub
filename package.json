{
  "name": "sensei-hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:run": "node scripts/dev-run.mjs",
    "fetch:mongodb": "node scripts/fetch-mongodb.mjs",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "dev:dojo": "node scripts/dev-run.mjs dojo",
    "dev:arena": "node scripts/dev-run.mjs arena",
    "dev:seed": "node scripts/dev-seed.mjs",
    "package:dojo": "node scripts/package-app.mjs dojo",
    "package:arena": "node scripts/package-app.mjs arena",
    "package:installer:win": "node scripts/package-installer.mjs -- --x64"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
